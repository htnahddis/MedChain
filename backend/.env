cat > backend/.env << 'EOF'
# Database
DATABASE_URL=postgresql://medchain_user:medchain_pass@localhost:5432/medchain_db

# Anthropic (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenFDA (optional, free tier works without key)
OPENFDA_API_KEY=

# App settings
HOSPITAL_BED_COUNT=500
FORECAST_HORIZON_DAYS=90
SERVICE_LEVEL=0.95
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars

# CORS - frontend URL
FRONTEND_URL=http://localhost:5173