# Database
DATABASE_URL=postgresql://medchain_user:YOUR_PASSWORD@localhost:5432/medchain_db

# Groq (get from https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenFDA (optional, free tier works without key)
OPENFDA_API_KEY=

# App settings
HOSPITAL_BED_COUNT=500
FORECAST_HORIZON_DAYS=90
SERVICE_LEVEL=0.95
DEBUG=true
SECRET_KEY=generate_a_secret_key_for_production

# CORS - frontend URL
FRONTEND_URL=http://localhost:5173
